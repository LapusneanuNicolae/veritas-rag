# Copy to .env and fill in. NEVER commit your real .env.

# LLM provider: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_API_KEY=sk-your-key-here

# Infrastructure (defaults match docker-compose)
DATABASE_URL=postgresql+psycopg://veritas:veritas@localhost:5432/veritas
REDIS_URL=redis://localhost:6379/0
